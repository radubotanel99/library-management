{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git show *)",

      "Bash(mvn test *)",
      "Bash(mvn -q test *)",
      "Bash(mvn clean test *)",
      "Bash(mvn clean install *)",
      "Bash(mvn verify *)",
      "Bash(mvn spring-boot:run *)",
      "Bash(mvn flyway:info *)",
      "Bash(mvn flyway:validate *)",

      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)",
      "Bash(docker compose build *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",

      "Bash(ng test *)",
      "Bash(ng build *)",
      "Bash(ng serve *)",
      "Bash(npm run *)",
      "Bash(npm test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(docker compose up -d --build *)",
      "Bash(mvn flyway:migrate *)",
      "Bash(mvn flyway:clean *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/application-prod.yml)",
      "Read(**/secrets/**)"
    ]
  }
}